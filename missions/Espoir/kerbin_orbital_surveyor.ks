// Espoir local polar mapper;100km stays above Kerbin's atmosphere.
SET MISSION_ID TO "kerbin_orbital_surveyor".
SET MISSION_NAME TO "Espoir — Kerbin Polar Surveyor".
SET MISSION_TYPE TO "kerbin_orbit".
SET MISSION_CACHE_NEXT_BAND TO 1.
SET TARGET_ TO "KERBIN".
SET PAYLOADS TO LIST("SCANSAT").
SET SEQUENCE TO LIST("PRELAUNCH","LAUNCH","FAIR","ANTS","PARK","SHAPE","SCANSAT_OPS","DONE").
SET PARKING_ALT TO 100000.
SET LAUNCH_PLANE_MODE TO "".
SET LAUNCH_INCLINATION TO 90.
SET TARGET_INCLINATION TO 90.
SET CAPTURE_INC TO -1.
SET CAPTURE_LAN TO -1.
SET TARGET_PE TO 100000.
SET TARGET_AP TO 100000.
SET SHAPE_PE TO 100000.
SET SHAPE_AP TO 100000.
SET SHAPE_INC TO 90.
SET SHAPE_LAN TO -1.
SET SHAPE_AOP TO -1.
SET SHAPE_MIN_PE TO 80000.
SET SHAPE_ALT_TOL TO 1000.
SET SHAPE_ANG_TOL TO 0.5.
SET SHAPE_MIN_BURN_DV TO 0.1.
SET SHAPE_DV_CAP TO 150.
SET SHAPE_TOTAL_DV_CAP TO 250.
SET SHAPE_RESERVE_DV TO 100.
// Keep the complete probe on station; no release/disposal stage assumed.
SET SCANSAT_DECOUPLER_TAG TO "".
SET SCANSAT_DISPOSE_CARRIER TO 0.
SET SCANSAT_AUTO_DEORBIT TO 0.
SET SCANSAT_POWER_GUARD TO 1.
SET SCANSAT_POWER_LOW TO 0.3.
SET SCANSAT_POWER_RESUME TO 0.6.
SET SCANSAT_REQUIRED_TYPES TO LIST("LOW_RES_ALTIMETRY","LOW_RES_RESOURCES","BIOME").
SET SOLAR_REORIENT_PERIOD TO 21600.
SET COAST_AUTO_WARP TO 0.
