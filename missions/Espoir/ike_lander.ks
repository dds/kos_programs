// Espoir: one-way Ike surface science. No ascent or Kerbin-return leg.
// Build allowance after85km LKO:1500m/s transfer +1300m/s operations.
// Retain the CPU, communications, power, landing engine and legs together.
SET MISSION_ID TO "ike_lander".
SET MISSION_NAME TO "Espoir — Ike Science Lander".
SET MISSION_TYPE TO "interplanetary".
SET MISSION_CACHE_NEXT_BAND TO 1.
SET MISSION_CACHE_HANDOFF_PHASES TO LIST("XING","BPLANE","COAST_1HALF").
SET TARGET_ TO "DUNA".
SET PAYLOADS TO LIST("PROBE").
SET SEQUENCE TO LIST("PRELAUNCH","LAUNCH","FAIR","ANTS","PARK","XING","ASSIST","ASSIST_COAST","BPLANE","COAST_1HALF","REFINE_BPLANE","COAST_2HALF","CAPTURE","IKE_SETUP").
SET PARKING_ALT TO 85000.
SET LAUNCH_INCLINATION TO 0.
SET LAUNCH_PLANE_MODE TO "INTERPLANETARY".
SET TRANSFER_SCAN_SAMPLES_PER_ORBIT TO 16.
SET CAPTURE_PE TO 85000.
SET CAPTURE_MIN_PE TO 80000.
SET CAPTURE_MAX_PE TO 90000.
SET CAPTURE_INC TO 0.
SET CAPTURE_LAN TO -1.
SET CAPTURE_AOP TO -1.
SET CAPTURE_DIR TO "PROGRADE".
SET TARGET_AP TO 2880000.
SET BPLANE_PE_ONLY TO 0.
SET BPLANE_REQUIRE_PLANE TO 0.
SET BPLANE_PE_TOL TO 5000.
SET BPLANE_DV_CAP TO 150.
SET REFINE_BPLANE_DV_CAP TO 50.
SET BPLANE_TRIM_DV_CAP TO 150.
SET BPLANE_TRIM_TOTAL_DV_CAP TO 250.
SET BPLANE_TRIM_RESERVE_DV TO 1100.
SET CAPTURE_RESERVE_DV TO 1000.
SET COAST_AUTO_WARP TO 0.

SET IKE_FLYBY_SEQUENCE TO LIST("XING","BPLANE","COAST_1HALF","REFINE_BPLANE","COAST_2HALF","CAPTURE","LANDING_REVIEW","LAND_DEORBIT","LAND_ASSIST","SURFACE_SCIENCE","DONE").
SET IKE_FLYBY_PE TO 25000.
SET IKE_FLYBY_INC TO 90.
SET IKE_TRANSFER_SCAN_LOOKAHEAD_HOURS TO 48.
SET IKE_TRANSFER_SCAN_SAMPLES_PER_ORBIT TO 32.
SET IKE_BPLANE_DV_CAP TO 100.
SET IKE_REFINE_BPLANE_DV_CAP TO 30.
SET IKE_MISSION_SETTINGS TO LEXICON(
    "MISSION_ID","ike_lander_ops","MISSION_NAME","Espoir — Ike Surface Science",
    "MISSION_CACHE_NEXT_BAND",1,"MISSION_CACHE_HANDOFF_PHASES",LIST(),"COAST_AUTO_WARP",0,"MISSION_TYPE","moon_operations","PAYLOADS",LIST("PROBE"),
    "CAPTURE_PE",25000,"CAPTURE_MIN_PE",23000,"CAPTURE_MAX_PE",27000,
    "CAPTURE_INC",90,"CAPTURE_LAN",-1,"CAPTURE_AOP",-1,"CAPTURE_DIR","POLAR",
    "TARGET_AP",25000,"CAPTURE_RESERVE_DV",650,
    "BPLANE_PE_ONLY",0,"BPLANE_REQUIRE_PLANE",1,"BPLANE_PE_TOL",2000,"BPLANE_ANG_TOL",0.5,
    "BPLANE_TRIM_DV_CAP",100,"BPLANE_TRIM_TOTAL_DV_CAP",150,"BPLANE_TRIM_RESERVE_DV",700,
    "BPLANE_CAPTURE_MARGIN",650,
    "TARGET_LAT",0,"TARGET_LNG",0,"TARGET_LOCK",0,"TARGET_WAYPOINT","",
    "LANDING_USE_WAYPOINTS",1,"LANDING_FLEXIBLE_SITE",0,
    "LANDING_TARGET_REVIEW_REQUIRED",1,"LANDING_AUTO_TARGET",0,"LANDING_AUTO_TARGET_MINUTES",5,
    "LANDING_CONFIRM_TARGET",0,"LANDING_SKIP_TARGET_SEARCH",0,
    "LANDING_LIGHT_MODE","SUNLIT","LANDING_SUN_MIN_ELEV",5,"LANDING_SUN_MAX_ELEV",85,
    "LANDING_SUN_PREFERRED_ELEV",30,"LANDING_LIGHT_SETTING_PENALTY",1,
    "LANDING_RADIO_MODE","DIRECT","LANDING_REQUIRE_KERBIN",1,
    "LANDING_KERBIN_MIN_ELEV",15,"LANDING_KERBIN_PREFERRED_ELEV",30,
    "LANDING_LIGHT_KERBIN_WEIGHT",1,"LANDING_LIGHT_SUN_WEIGHT",0.1,
    "LANDING_ECONOMY_BRAKE",1,"LANDING_POWERED_LEAD",1,
    "LANDING_ECONOMY_TERMINAL_RETARGET",0,"LANDING_APPROACH_MAX_TIME",120,
    "LANDING_STAGE_BRAKE_CREDIT",1,"LANDING_STAGE_DISCARD_HSPEED",0,
    "LANDING_RETURN_DECOUPLER_TAG","","LANDING_RELEASE_DECOUPLER_TAG","",
    "LANDING_SITE_SCAN_ENABLE",1,"LANDING_REQUIRE_SITE",0,
    "LANDING_SITE_SCAN_RADIUS",500,"LANDING_SITE_SCAN_STEP",100,"LANDING_SITE_MAX_SLOPE",5,
    "LANDING_TERRAIN_MAX_SLOPE",5,"LANDING_DIVERT_EMERGENCY_SLOPE",15,
    "TERRAIN_VALIDATE",TRUE,"TERRAIN_CHECK_RADIUS",500,"TERRAIN_CHECK_STEP",100,"MAX_TILT",12,
    "TARGET_TOLERANCE",1500,"GUIDANCE_ALT",3000,
    "TARGET_DEORBIT_SCAN_ORBITS",4,"TARGET_DEORBIT_SCAN_SAMPLES",512,
    "TARGET_DEORBIT_MIN_LEAD",120,"TARGET_DEORBIT_NORMAL_DV_CAP",10,
    "TARGET_DEORBIT_PREFERRED_CROSSTRACK_KM",0.25,"DEORBIT_CROSSTRACK_AUTHORITY_KM",0.5,
    "RELOAD_AFTER_LAND_ASSIST",0,"RELOAD_AFTER_LAND",0,
    "SCIENCE_SURFACE_DWELL",600,"SCIENCE_SURFACE_MIN_EC",0.05).

// Optional direct Duna flyby -> Ike capture; no Duna parking/transfer on success.
SET MISSION_ASSIST_ROUTE TO LIST(
    LEXICON("BODY","Duna","MIN_PE",80000,"MAX_PE",90000),
    LEXICON("BODY","Ike","MIN_PE",23000,"MAX_PE",25000,"AP",25000,"INC",90,"INC_TOL",0.5)).
SET MISSION_ASSIST_SEQUENCE TO IKE_FLYBY_SEQUENCE.
SET MISSION_ASSIST_SETTINGS TO IKE_MISSION_SETTINGS.
SET ASSIST_RESERVE_DV TO 650.
