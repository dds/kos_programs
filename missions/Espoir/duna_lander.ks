// Espoir:70km polar parking; operator site selection, chutes + terminal burn.
// Capture/landing affordability is measured before each actual burn.
// Optional science on a free Ike flyby: cmd/flybyscience.ks,1 then reboot.
SET MISSION_ID TO "duna_lander".
SET MISSION_NAME TO "Espoir — Duna Science Lander".
SET MISSION_TYPE TO "interplanetary".
SET MISSION_CACHE_NEXT_BAND TO 1.
SET TARGET_ TO "DUNA".
SET PAYLOADS TO LIST("PROBE").
SET SEQUENCE TO LIST("PRELAUNCH","LAUNCH","FAIR","ANTS","PARK","XING","ASSIST","ASSIST_COAST","BPLANE","COAST_1HALF","REFINE_BPLANE","COAST_2HALF","CAPTURE","SHAPE","LANDING_REVIEW","ATMO_DEORBIT","SCIENCE_ENTRY","SURFACE_SCIENCE","DONE").
SET PARKING_ALT TO 85000.
SET LAUNCH_INCLINATION TO 0.
SET LAUNCH_PLANE_MODE TO "INTERPLANETARY".
SET TRANSFER_SCAN_SAMPLES_PER_ORBIT TO 16.
SET BPLANE_ARRIVAL_MODE TO "ORBIT".
SET CAPTURE_PE TO 70000.
SET CAPTURE_MIN_PE TO 68000.
SET CAPTURE_MAX_PE TO 72000.
SET CAPTURE_INC TO 90.
SET CAPTURE_DIR TO "POLAR".
SET CAPTURE_LAN TO -1.
SET CAPTURE_AOP TO -1.
SET TARGET_AP TO 70000.
SET BPLANE_PE_ONLY TO 0.
SET BPLANE_REQUIRE_PLANE TO 1.
SET BPLANE_ANG_TOL TO 0.5.
SET BPLANE_PE_TOL TO 2000.
SET BPLANE_DV_CAP TO 150.
SET REFINE_BPLANE_DV_CAP TO 50.
SET BPLANE_TRIM_DV_CAP TO 150.
SET BPLANE_TRIM_TOTAL_DV_CAP TO 250.
SET BPLANE_TRIM_RESERVE_DV TO 1000.
SET CAPTURE_RESERVE_DV TO 700.
SET SHAPE_PE TO 70000.
SET SHAPE_AP TO 70000.
SET SHAPE_INC TO 90.
SET SHAPE_LAN TO -1.
SET SHAPE_AOP TO -1.
SET SHAPE_MIN_PE TO 60000.
SET SHAPE_ALT_TOL TO 1000.
SET SHAPE_ANG_TOL TO 0.5.
SET SHAPE_DV_CAP TO 300.
SET SHAPE_TOTAL_DV_CAP TO 500.
SET SHAPE_RESERVE_DV TO 600.
SET TARGET_LAT TO 0.
SET TARGET_LNG TO 0.
SET TARGET_LOCK TO 0.
SET TARGET_WAYPOINT TO "".
SET LANDING_USE_WAYPOINTS TO 1.
SET LANDING_FLEXIBLE_SITE TO 0.
SET LANDING_AUTO_TARGET TO 0.
SET LANDING_TARGET_REVIEW_REQUIRED TO 1.
SET LANDING_LIGHT_MODE TO "SUNLIT".
SET LANDING_SUN_MIN_ELEV TO 5.
SET LANDING_SUN_MAX_ELEV TO 85.
SET LANDING_RADIO_MODE TO "DIRECT".
SET LANDING_REQUIRE_KERBIN TO 1.
SET LANDING_KERBIN_MIN_ELEV TO 15.
SET ENTRY_POWERED_LANDING TO 1.
SET ENTRY_LANDING_RESERVE_DV TO 300.
SET SCIENCE_SURFACE_DWELL TO 600.
SET SCIENCE_ENTRY_BANDS TO LEXICON("DUNA",LIST(140000,12000),"IKE",LIST(50000,0)).
// Keep encounter safety checks active even when optional sampling is off.
SET SCIENCE_ENTRY_MOON TO "IKE".
SET SCIENCE_ENTRY_MOON_MIN_PE TO 20000.
SET MISSION_ASSIST_SCIENCE TO 0.
SET SCIENCE_ENTRY_PREPARE_LEAD TO 180.
SET SCIENCE_ENTRY_MAX_PASSES TO 3.
SET SCIENCE_ENTRY_MIN_EC TO 0.05.
// Deploy attached stock chutes only when native conditions are safe.
// Atmospheric deorbit requires attached stock chutes and terminal authority.
SET SCIENCE_ENTRY_CHUTES TO 1.
SET COAST_AUTO_WARP TO 0.

// Optional Ike assist must still end in the requested safe polar parking orbit.
SET MISSION_ASSIST_ROUTE TO LIST(
    LEXICON("BODY","Ike","MIN_PE",20000),
    LEXICON("BODY","Duna","MIN_PE",68000,"MAX_PE",70000,"AP",70000,"INC",90,"INC_TOL",0.5)).
SET MISSION_ASSIST_SEQUENCE TO SEQUENCE.
SET MISSION_ASSIST_SETTINGS TO LEXICON("CAPTURE_PE",70000,"CAPTURE_MIN_PE",68000,
    "CAPTURE_MAX_PE",72000,"CAPTURE_INC",90,"BPLANE_ANG_TOL",0.5,"TARGET_AP",70000,"CAPTURE_RESERVE_DV",700,
    "ENTRY_POWERED_LANDING",1,"ENTRY_LANDING_RESERVE_DV",300).
SET ASSIST_RESERVE_DV TO 700.
