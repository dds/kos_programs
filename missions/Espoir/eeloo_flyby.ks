// Eeloo science flyby with an affordable high, polar capture if possible.
// All figures are altitudes. No circularization, landing or return assumed.
SET MISSION_ID TO "eeloo_flyby".
SET MISSION_NAME TO "Espoir — Eeloo Flyby and Optional Polar Capture".
SET MISSION_TYPE TO "interplanetary".
SET MISSION_CACHE_NEXT_BAND TO 1.
SET TARGET_ TO "EELOO".
SET PAYLOADS TO LIST("PROBE").
SET SEQUENCE TO LIST("PRELAUNCH","LAUNCH","FAIR","ANTS","PARK","XING","BPLANE",
    "COAST_1HALF","REFINE_BPLANE","COAST_2HALF","CAPTURE","FLYBY","SCIENCE_OPS","DONE").
SET PARKING_ALT TO 85000.
SET LAUNCH_INCLINATION TO 0.
SET LAUNCH_PLANE_MODE TO "INTERPLANETARY".
SET TRANSFER_SCAN_SAMPLES_PER_ORBIT TO 16.

// Plane targeting before arrival avoids buying a 90-degree turn in orbit.
// FLYBY arrival policy leaves capture optional; CAPTURE checks its live node.
SET CAPTURE_PE TO 25000.
SET CAPTURE_MIN_PE TO 20000.
SET CAPTURE_MAX_PE TO 30000.
SET CAPTURE_INC TO 90.
SET CAPTURE_LAN TO -1.
SET CAPTURE_AOP TO -1.
SET CAPTURE_DIR TO "POLAR".
SET TARGET_AP TO 5000000.
SET CAPTURE_RESERVE_DV TO 150.
SET CAPTURE_ACCEPT_BOUND TO 1.
SET CAPTURE_OPTIONAL_FLYBY TO 1.
SET BPLANE_ARRIVAL_MODE TO "FLYBY".
SET BPLANE_PE_ONLY TO 0.
SET BPLANE_REQUIRE_PLANE TO 1.
SET BPLANE_ANG_TOL TO 1.
SET BPLANE_PE_TOL TO 2000.
SET BPLANE_MINIMUM_PE_TOL TO 5000.
SET BPLANE_DV_CAP TO 150.
SET REFINE_BPLANE_DV_CAP TO 50.
SET BPLANE_TRIM_DV_CAP TO 150.
SET BPLANE_TRIM_TOTAL_DV_CAP TO 250.
SET BPLANE_TRIM_RESERVE_DV TO 150.
SET BPLANE_CAPTURE_MARGIN TO 150.

// Run supported science through the close pass, including after capture.
// Queued transmission is not proof of delivery; retain data without a link.
SET FLYBY_SCIENCE TO 1.
SET FLYBY_SCIENCE_LOW_ALT TO 60000.
SET FLYBY_SCIENCE_MIN_EC TO 0.3.
SET FLYBY_POST_PE_HOLD TO 600.
SET FLYBY_EXIT_SOI TO 0.
SET FLYBY_NEXT_TARGET TO "EELOO".
SET SCIENCE_OPS_HOLD TO 1.
SET SCIENCE_OPS_RUN_ALL TO 0.
SET SOLAR_REORIENT_PERIOD TO 21600.
SET COAST_AUTO_WARP TO 0.
