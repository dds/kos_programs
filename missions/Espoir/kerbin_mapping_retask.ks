// Retask an orbiting Espoir after its contract; no launch or payload release.
// Molniya-to-polar shaping keeps the northern contract's allowance/reserve.
SET MISSION_ID TO "kerbin_mapping_retask".
SET MISSION_NAME TO "Espoir — Kerbin Polar Mapping Retask".
SET MISSION_TYPE TO "kerbin_orbit".
SET MISSION_CACHE_NEXT_BAND TO 1.
SET TARGET_ TO "KERBIN".
SET PAYLOADS TO LIST("SCANSAT","RELAY").
SET SEQUENCE TO LIST("SHAPE","SCANSAT_OPS","DONE").
SET TARGET_PE TO 160000.
SET TARGET_AP TO 230000.
// Keep Pe near the completed contract's163.6km to preserve fuel margin.
SET SHAPE_PE TO 160000.
SET SHAPE_AP TO 230000.
SET SHAPE_INC TO 90.
SET SHAPE_LAN TO -1.
SET SHAPE_AOP TO -1.
SET SHAPE_MIN_PE TO 80000.
SET SHAPE_ALT_TOL TO 1000.
SET SHAPE_OPERATIONAL_TOLERANCE TO 1.
SET SHAPE_ANG_TOL TO 0.5.
SET SHAPE_MIN_BURN_DV TO 0.1.
SET SHAPE_DV_CAP TO 1500.
SET SHAPE_TOTAL_DV_CAP TO 2500.
SET SHAPE_RESERVE_DV TO 100.
SET SCANSAT_DECOUPLER_TAG TO "".
SET SCANSAT_DISPOSE_CARRIER TO 0.
SET SCANSAT_DISPOSE_BEFORE_RELEASE TO 0.
SET SCANSAT_STAGE_AFTER_RELEASE TO 0.
SET SCANSAT_AUTO_DEORBIT TO 0.
SET SCANSAT_POWER_GUARD TO 1.
SET SCANSAT_POWER_LOW TO 0.3.
SET SCANSAT_POWER_RESUME TO 0.6.
SET SCANSAT_REQUIRED_TYPES TO LIST("BIOME").
SET SOLAR_REORIENT_PERIOD TO 21600.
SET COAST_AUTO_WARP TO 0.
