// Mun contract orbit, then command-selected polar surveying and Kerbin return.
// Confirm contract at SCIENCE_OPS, run orbit.ks with after=scan, then REBOOT.
// Mapping completion continues to RETURN_SETUP; an early return is explicit.
SET MISSION_ID TO "mun_contract_survey_return".
SET MISSION_NAME TO "Espoir — Mun Contract, Polar Survey and Return".
SET MISSION_TYPE TO "kerbin_moon".
SET MISSION_EXCURSIONS TO 1.
SET MISSION_CACHE_NEXT_BAND TO 1.
SET TARGET_ TO "MUN".
SET PAYLOADS TO LIST("SCANSAT").
SET SEQUENCE TO LIST("PRELAUNCH","LAUNCH","FAIR","ANTS","PARK","XING","BPLANE",
    "COAST_1HALF","REFINE_BPLANE","COAST_2HALF","CAPTURE","SHAPE","SCIENCE_OPS","RETURN_SETUP").
SET PARKING_ALT TO 85000.
SET LAUNCH_INCLINATION TO 0.
SET LAUNCH_PLANE_MODE TO "BODY_ORBIT".
SET TRANSFER_SCAN_SAMPLES_PER_ORBIT TO 16.
// Keep a cheap stage-impact path; pause for optional manual staging before
// BPLANE repairs the probe. Never separate hardware automatically.
SET TRANSFER_IMPACT_TARGET TO 1.
SET TRANSFER_IMPACT_AIM_PE TO -5000.
SET TRANSFER_IMPACT_REFINE_DV_CAP TO 5.
// Capture low, retaining high Ap for inexpensive plane/apsis corrections.
// Prefer retrograde arrival; SHAPE owns the required final180deg plane.
SET CAPTURE_PE TO 15000.
SET CAPTURE_MIN_PE TO 13000.
SET CAPTURE_MAX_PE TO 17000.
SET CAPTURE_ACCEPT_BOUND TO 0.
SET CAPTURE_INC TO 180.
SET CAPTURE_LAN TO -1.
SET CAPTURE_AOP TO -1.
SET CAPTURE_DIR TO "RETROGRADE".
SET TARGET_AP TO 1737680.
SET TARGET_PE TO 15000.
SET BPLANE_PE_ONLY TO 0.
SET BPLANE_REQUIRE_PLANE TO 0.
SET BPLANE_PE_TOL TO 2000.
SET BPLANE_ANG_TOL TO 0.5.
SET BPLANE_DV_CAP TO 100.
SET REFINE_BPLANE_DV_CAP TO 100.
SET BPLANE_TRIM_DV_CAP TO 100.
SET BPLANE_TRIM_TOTAL_DV_CAP TO 200.
// Allow for contract shaping, polar mapping insertion, then departure.
// These are admission floors; the live native planners still price each burn.
SET BPLANE_TRIM_RESERVE_DV TO 1200.
SET BPLANE_CAPTURE_MARGIN TO 1200.
SET CAPTURE_RESERVE_DV TO 1200.
SET SHAPE_AP TO 1737680.
SET SHAPE_PE TO 1543150.
SET SHAPE_INC TO 180.
SET SHAPE_LAN TO -1.
SET SHAPE_AOP TO -1.
SET SHAPE_ALT_TOL TO 500.
SET SHAPE_ANG_TOL TO 0.1.
SET SHAPE_MIN_PE TO 10000.
SET SHAPE_MIN_BURN_DV TO 0.002.
SET SHAPE_BURN_TOLERANCE TO 0.001.
SET SHAPE_DV_CAP TO 600.
SET SHAPE_TOTAL_DV_CAP TO 1800.
SET SHAPE_RESERVE_DV TO 400.
SET EXCURSION_RESERVE_DV TO 400.
SET SCIENCE_OPS_HOLD TO 1.
SET SCIENCE_OPS_RUN_ALL TO 0.
SET AUTO_TRANSMIT TO 0.
// The orbit command clears the contract goals and retains the return tail.
// Shared SHAPE changes plane while high, before lowering to70km polar.
SET SCANSAT_DECOUPLER_TAG TO "".
SET SCANSAT_DISPOSE_CARRIER TO 0.
SET SCANSAT_DISPOSE_BEFORE_RELEASE TO 0.
SET SCANSAT_STAGE_AFTER_RELEASE TO 0.
SET SCANSAT_AUTO_DEORBIT TO 0.
SET SCANSAT_POWER_GUARD TO 1.
SET SCANSAT_POWER_LOW TO 0.3.
SET SCANSAT_POWER_RESUME TO 0.6.
SET SCANSAT_TARGET_COVERAGE TO 95.
SET SCANSAT_REQUIRED_TYPES TO LIST("LOW_RES_ALTIMETRY","LOW_RES_RESOURCES","BIOME").
SET SOLAR_REORIENT_PERIOD TO 21600.
SET COAST_AUTO_WARP TO 0.
SET RETURN_SEQUENCE TO LIST("ESCAPE","COAST","MCC","AEROBRAKE","DESCENT","DONE").
SET RETURN_PE TO 52000.
SET RETURN_PE_TOLERANCE TO 1000.
SET RETURN_PE_MIN TO 52000.
SET RETURN_REENTRY_DIR TO "RETROGRADE".
SET RETURN_KSC_TARGET TO 0.
SET RETURN_ARM_CHUTES TO 1.
// Keep the complete probe; no RO9 separator/chute-tag assumptions.
SET RETURN_DESCENT_FAIRING_TAG TO "none".
SET RETURN_DESCENT_DECOUPLER_TAG TO "none".
SET RETURN_DESCENT_CHUTES_TAG TO "".
SET AEROBRAKE_AP_BURN TO 1.
SET AEROBRAKE_AP_RESERVE_DV TO 10.
