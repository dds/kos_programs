// Espoir local descent test: park first, select coordinates, then target entry.
// Parachutes carry touchdown; engine assistance is optional, never staged.
SET MISSION_ID TO "kerbin_lander".
SET MISSION_NAME TO "Espoir — Kerbin Science Lander".
SET MISSION_TYPE TO "kerbin_orbit".
SET MISSION_CACHE_NEXT_BAND TO 1.
SET TARGET_ TO "KERBIN".
SET PAYLOADS TO LIST("PROBE").
SET SEQUENCE TO LIST("PRELAUNCH","LAUNCH","FAIR","ANTS","PARK","SHAPE","LANDING_REVIEW","ATMO_DEORBIT","SCIENCE_ENTRY","SURFACE_SCIENCE","DONE").
SET PARKING_ALT TO 100000.
SET LAUNCH_PLANE_MODE TO "".
SET LAUNCH_INCLINATION TO 90.
SET TARGET_INCLINATION TO 90.
SET CAPTURE_INC TO -1.
SET CAPTURE_LAN TO -1.
SET TARGET_PE TO 100000.
SET TARGET_AP TO 100000.
SET SHAPE_PE TO 100000.
SET SHAPE_AP TO 100000.
SET SHAPE_INC TO 90.
SET SHAPE_LAN TO -1.
SET SHAPE_AOP TO -1.
SET SHAPE_MIN_PE TO 80000.
SET SHAPE_ALT_TOL TO 1000.
SET SHAPE_ANG_TOL TO 0.5.
SET SHAPE_MIN_BURN_DV TO 0.1.
SET SHAPE_DV_CAP TO 150.
SET SHAPE_TOTAL_DV_CAP TO 250.
SET SHAPE_RESERVE_DV TO 150.
// No default landing coordinate. cmd/landsite selects a surveyed site in orbit.
SET TARGET_LAT TO 0.
SET TARGET_LNG TO 0.
SET TARGET_LOCK TO 0.
SET TARGET_WAYPOINT TO "".
SET LANDING_USE_WAYPOINTS TO 1.
SET LANDING_FLEXIBLE_SITE TO 0.
SET LANDING_AUTO_TARGET TO 0.
SET LANDING_TARGET_REVIEW_REQUIRED TO 1.
SET LANDING_LIGHT_MODE TO "SUNLIT".
SET LANDING_SUN_MIN_ELEV TO 5.
SET LANDING_SUN_MAX_ELEV TO 85.
// Kerbin ground stations supply the link; a view of Kerbin's center is not
// a home-station visibility test. This does not assume a relay network.
SET LANDING_RADIO_MODE TO "AUTO".
SET LANDING_REQUIRE_KERBIN TO 0.
// Keep the established Kerbin entry depth; do not inherit Duna's5km Pe.
SET ATMO_DEORBIT_PE TO 52000.
SET ATMO_DEORBIT_PE_TOLERANCE TO 1000.
SET ENTRY_POWERED_LANDING TO 1.
SET ENTRY_LANDING_REQUIRE_POWER TO 0.
SET ENTRY_LANDING_RESERVE_DV TO 50.
SET SCIENCE_ENTRY_BANDS TO LEXICON("KERBIN",LIST(250000,18000)).
SET SCIENCE_ENTRY_MOON TO "".
SET SCIENCE_ENTRY_PREPARE_LEAD TO 180.
SET SCIENCE_ENTRY_MAX_PASSES TO 3.
SET SCIENCE_ENTRY_MIN_EC TO 0.05.
SET SCIENCE_ENTRY_CHUTES TO 1.
SET SCIENCE_SURFACE_DWELL TO 600.
SET COAST_AUTO_WARP TO 0.
