// Powered polar capture and attached SCANsat operations; no landing/return.
SET MISSION_ID TO "moho_orbital_surveyor".
SET MISSION_NAME TO "Espoir — Moho Orbital Surveyor".
SET MISSION_TYPE TO "interplanetary".
SET MISSION_CACHE_NEXT_BAND TO 1.
SET TARGET_ TO "MOHO".
SET PAYLOADS TO LIST("SCANSAT").
SET SEQUENCE TO LIST("PRELAUNCH","LAUNCH","FAIR","ANTS","PARK","XING","BPLANE",
    "COAST_1HALF","REFINE_BPLANE","COAST_2HALF","CAPTURE","SHAPE","SCANSAT_OPS","DONE").
SET PARKING_ALT TO 85000.
SET LAUNCH_INCLINATION TO 0.
SET LAUNCH_PLANE_MODE TO "INTERPLANETARY".
SET TRANSFER_SCAN_SAMPLES_PER_ORBIT TO 16.
SET CAPTURE_PE TO 70000.
SET CAPTURE_MIN_PE TO 68000.
SET CAPTURE_MAX_PE TO 72000.
SET CAPTURE_INC TO 90.
SET CAPTURE_LAN TO -1.
SET CAPTURE_AOP TO -1.
SET CAPTURE_DIR TO "POLAR".
SET TARGET_AP TO 70000.
SET BPLANE_PE_ONLY TO 0.
SET BPLANE_REQUIRE_PLANE TO 1.
SET BPLANE_PE_TOL TO 2000.
SET BPLANE_ANG_TOL TO 0.5.
SET BPLANE_DV_CAP TO 150.
SET REFINE_BPLANE_DV_CAP TO 50.
SET BPLANE_TRIM_DV_CAP TO 150.
SET BPLANE_TRIM_TOTAL_DV_CAP TO 250.
SET BPLANE_TRIM_RESERVE_DV TO 400.
SET BPLANE_CAPTURE_MARGIN TO 300.
SET CAPTURE_RESERVE_DV TO 300.
SET SHAPE_PE TO 70000.
SET SHAPE_AP TO 70000.
SET SHAPE_INC TO 90.
SET SHAPE_LAN TO -1.
SET SHAPE_AOP TO -1.
SET SHAPE_MIN_PE TO 10000.
SET SHAPE_ALT_TOL TO 1000.
SET SHAPE_ANG_TOL TO 0.5.
SET SHAPE_DV_CAP TO 300.
SET SHAPE_TOTAL_DV_CAP TO 500.
SET SHAPE_RESERVE_DV TO 150.
SET SCANSAT_DECOUPLER_TAG TO "".
SET SCANSAT_DISPOSE_CARRIER TO 0.
SET SCANSAT_AUTO_DEORBIT TO 0.
SET SCANSAT_POWER_GUARD TO 1.
SET SCANSAT_POWER_LOW TO 0.3.
SET SCANSAT_POWER_RESUME TO 0.6.
SET SCANSAT_REQUIRED_TYPES TO LIST("LOW_RES_ALTIMETRY","LOW_RES_RESOURCES","BIOME").
SET SOLAR_REORIENT_PERIOD TO 21600.
SET COAST_AUTO_WARP TO 0.
