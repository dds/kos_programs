// Espoir: high Duna capture, separate Ike transfer/capture, polar mapping.
// Build allowance after85km LKO:1500m/s transfer +800m/s operations.
SET MISSION_ID TO "ike_orbital_surveyor".
SET MISSION_NAME TO "Espoir — Ike Orbital Surveyor".
SET MISSION_TYPE TO "interplanetary".
SET MISSION_CACHE_NEXT_BAND TO 1.
SET MISSION_CACHE_HANDOFF_PHASES TO LIST("XING","BPLANE","COAST_1HALF").
SET TARGET_ TO "DUNA".
SET PAYLOADS TO LIST("SCANSAT").
SET SEQUENCE TO LIST("PRELAUNCH","LAUNCH","FAIR","ANTS","PARK","XING","ASSIST","ASSIST_COAST","BPLANE","COAST_1HALF","REFINE_BPLANE","COAST_2HALF","CAPTURE","IKE_SETUP").
SET PARKING_ALT TO 85000.
SET LAUNCH_INCLINATION TO 0.
SET LAUNCH_PLANE_MODE TO "INTERPLANETARY".
SET TRANSFER_SCAN_SAMPLES_PER_ORBIT TO 16.
// Avoid a low circular Duna orbit and atmospheric capture.
SET CAPTURE_PE TO 85000.
SET CAPTURE_MIN_PE TO 80000.
SET CAPTURE_MAX_PE TO 90000.
SET CAPTURE_INC TO 0.
SET CAPTURE_LAN TO -1.
SET CAPTURE_AOP TO -1.
SET CAPTURE_DIR TO "PROGRADE".
SET TARGET_AP TO 2880000.
SET BPLANE_PE_ONLY TO 0.
SET BPLANE_REQUIRE_PLANE TO 0.
SET BPLANE_PE_TOL TO 5000.
SET BPLANE_DV_CAP TO 150.
SET REFINE_BPLANE_DV_CAP TO 50.
SET BPLANE_TRIM_DV_CAP TO 150.
SET BPLANE_TRIM_TOTAL_DV_CAP TO 250.
SET BPLANE_TRIM_RESERVE_DV TO 700.
SET CAPTURE_RESERVE_DV TO 650.
SET COAST_AUTO_WARP TO 0.

// Historical name: this sequence now supports a captured operations leg.
SET IKE_FLYBY_SEQUENCE TO LIST("XING","BPLANE","COAST_1HALF","REFINE_BPLANE","COAST_2HALF","CAPTURE","SHAPE","SCANSAT_OPS","DONE").
SET IKE_FLYBY_PE TO 70000.
SET IKE_FLYBY_INC TO 90.
SET IKE_TRANSFER_SCAN_LOOKAHEAD_HOURS TO 48.
SET IKE_TRANSFER_SCAN_SAMPLES_PER_ORBIT TO 32.
SET IKE_BPLANE_DV_CAP TO 100.
SET IKE_REFINE_BPLANE_DV_CAP TO 30.
SET IKE_MISSION_SETTINGS TO LEXICON(
    "MISSION_ID","ike_orbital_surveyor_ops",
    "MISSION_NAME","Espoir — Ike Polar Mapping",
    "MISSION_CACHE_NEXT_BAND",1,"MISSION_CACHE_HANDOFF_PHASES",LIST(),"COAST_AUTO_WARP",0,"MISSION_TYPE","moon_operations","PAYLOADS",LIST("SCANSAT"),
    "CAPTURE_PE",70000,"CAPTURE_MIN_PE",68000,"CAPTURE_MAX_PE",72000,
    "CAPTURE_INC",90,"CAPTURE_LAN",-1,"CAPTURE_AOP",-1,"CAPTURE_DIR","POLAR",
    "TARGET_AP",70000,"CAPTURE_RESERVE_DV",300,
    "BPLANE_PE_ONLY",0,"BPLANE_REQUIRE_PLANE",1,"BPLANE_PE_TOL",2000,"BPLANE_ANG_TOL",0.2,
    "BPLANE_TRIM_DV_CAP",100,"BPLANE_TRIM_TOTAL_DV_CAP",150,"BPLANE_TRIM_RESERVE_DV",350,
    "SHAPE_PE",70000,"SHAPE_AP",70000,"SHAPE_INC",90,"SHAPE_LAN",-1,"SHAPE_AOP",-1,
    "SHAPE_MIN_PE",20000,"SHAPE_ALT_TOL",1000,"SHAPE_ANG_TOL",0.5,
    "SHAPE_DV_CAP",300,"SHAPE_TOTAL_DV_CAP",500,"SHAPE_RESERVE_DV",100,
    "SCANSAT_DECOUPLER_TAG","","SCANSAT_DISPOSE_CARRIER",0,"SCANSAT_AUTO_DEORBIT",0,
    "SCANSAT_POWER_GUARD",1,"SCANSAT_POWER_LOW",0.3,"SCANSAT_POWER_RESUME",0.6,
    "SCANSAT_REQUIRED_TYPES",LIST("LOW_RES_ALTIMETRY","LOW_RES_RESOURCES","BIOME"),
    "SOLAR_REORIENT_PERIOD",21600).

// Optional direct Duna flyby -> Ike capture; no Duna parking/transfer on success.
SET MISSION_ASSIST_ROUTE TO LIST(
    LEXICON("BODY","Duna","MIN_PE",80000,"MAX_PE",90000),
    LEXICON("BODY","Ike","MIN_PE",68000,"MAX_PE",70000,"AP",70000,"INC",90,"INC_TOL",0.2)).
SET MISSION_ASSIST_SEQUENCE TO IKE_FLYBY_SEQUENCE.
SET MISSION_ASSIST_SETTINGS TO IKE_MISSION_SETTINGS.
SET ASSIST_RESERVE_DV TO 300.
