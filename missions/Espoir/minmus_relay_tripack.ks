// Three independent passive relays; carrier supplies all deployment burns.
SET MISSION_ID TO "minmus_relay_tripack".
SET MISSION_NAME TO "Espoir — Minmus Relay Tri-Pack".
SET MISSION_TYPE TO "kerbin_moon".
SET MISSION_CACHE_NEXT_BAND TO 1.
SET TARGET_ TO "MINMUS".
SET PAYLOADS TO LIST("RELAY").
SET SEQUENCE TO LIST("PRELAUNCH","LAUNCH","FAIR","ANTS","PARK","XING","BPLANE",
    "COAST_1HALF","REFINE_BPLANE","COAST_2HALF","CAPTURE","SHAPE","RELAY_CONSTELLATION","DONE").
SET PARKING_ALT TO 85000.
SET LAUNCH_INCLINATION TO 0.
SET LAUNCH_PLANE_MODE TO "BODY_ORBIT".
SET TRANSFER_SCAN_SAMPLES_PER_ORBIT TO 16.
SET CAPTURE_PE TO 500000.
SET CAPTURE_MIN_PE TO 495000.
SET CAPTURE_MAX_PE TO 505000.
SET TARGET_AP TO 500000.
SET CAPTURE_INC TO 0.
SET CAPTURE_LAN TO -1.
SET CAPTURE_AOP TO -1.
SET CAPTURE_DIR TO "PROGRADE".
SET BPLANE_PE_ONLY TO 0.
// Arrival equator is preferred; SHAPE owns the final equatorial requirement.
SET BPLANE_REQUIRE_PLANE TO 0.
SET BPLANE_ANG_TOL TO 0.5.
SET BPLANE_PE_TOL TO 2000.
SET BPLANE_MINIMUM_PE_TOL TO 5000.
SET BPLANE_DV_CAP TO 100.
SET REFINE_BPLANE_DV_CAP TO 100.
SET BPLANE_TRIM_DV_CAP TO 100.
SET BPLANE_TRIM_TOTAL_DV_CAP TO 200.
SET BPLANE_TRIM_RESERVE_DV TO 200.
SET BPLANE_CAPTURE_MARGIN TO 200.
SET CAPTURE_RESERVE_DV TO 200.
SET SHAPE_PE TO 500000.
SET SHAPE_AP TO 500000.
SET SHAPE_INC TO 0.
SET SHAPE_LAN TO -1.
SET SHAPE_AOP TO -1.
SET SHAPE_ALT_TOL TO 500.
SET SHAPE_ANG_TOL TO 0.1.
SET SHAPE_DV_CAP TO 500.
SET SHAPE_TOTAL_DV_CAP TO 1000.
SET SHAPE_RESERVE_DV TO 150.
SET RELAY_COUNT TO 3.
SET RELAY_ALT TO 500000.
SET RELAY_VERIFY_HARDWARE TO 1.
SET RELAY_MIN_PANELS TO 6.
SET RELAY_MIN_EC TO 200.
SET RELAY_RESERVE_DV TO 50.
SET RELAY_PERIOD_TOLERANCE TO 5.
SET RELAY_NAME_PREFIX TO "Espoir-Minmus-Relay".
SET COAST_AUTO_WARP TO 0.
SET SOLAR_REORIENT_PERIOD TO 21600.
