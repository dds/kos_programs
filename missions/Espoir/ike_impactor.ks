// Espoir: capture safely at Ike, then deliberately deorbit while sampling.
// No soft-landing, ascent, return, or surface-science promise.
// Build allowance after85km LKO:1500m/s transfer +800m/s operations.
SET MISSION_ID TO "ike_impactor".
SET MISSION_NAME TO "Espoir — Ike Science Impactor".
SET MISSION_TYPE TO "interplanetary".
SET MISSION_CACHE_NEXT_BAND TO 1.
SET MISSION_CACHE_HANDOFF_PHASES TO LIST("XING","BPLANE","COAST_1HALF").
SET TARGET_ TO "DUNA".
SET PAYLOADS TO LIST("PROBE").
SET SEQUENCE TO LIST("PRELAUNCH","LAUNCH","FAIR","ANTS","PARK","XING","BPLANE","COAST_1HALF","REFINE_BPLANE","COAST_2HALF","CAPTURE","IKE_SETUP").
SET PARKING_ALT TO 85000.
SET LAUNCH_INCLINATION TO 0.
SET LAUNCH_PLANE_MODE TO "INTERPLANETARY".
SET TRANSFER_SCAN_SAMPLES_PER_ORBIT TO 16.
SET CAPTURE_PE TO 85000.
SET CAPTURE_MIN_PE TO 80000.
SET CAPTURE_MAX_PE TO 90000.
SET CAPTURE_INC TO 0.
SET CAPTURE_LAN TO -1.
SET CAPTURE_AOP TO -1.
SET CAPTURE_DIR TO "PROGRADE".
SET TARGET_AP TO 2880000.
SET BPLANE_PE_ONLY TO 0.
SET BPLANE_REQUIRE_PLANE TO 0.
SET BPLANE_PE_TOL TO 5000.
SET BPLANE_DV_CAP TO 150.
SET REFINE_BPLANE_DV_CAP TO 50.
SET BPLANE_TRIM_DV_CAP TO 150.
SET BPLANE_TRIM_TOTAL_DV_CAP TO 250.
SET BPLANE_TRIM_RESERVE_DV TO 500.
SET CAPTURE_RESERVE_DV TO 450.
SET COAST_AUTO_WARP TO 1.

SET IKE_FLYBY_SEQUENCE TO LIST("XING","BPLANE","COAST_1HALF","REFINE_BPLANE","COAST_2HALF","CAPTURE","SCIENCE_IMPACT","DONE").
SET IKE_FLYBY_PE TO 25000.
SET IKE_FLYBY_INC TO -1.
SET IKE_TRANSFER_SCAN_LOOKAHEAD_HOURS TO 48.
SET IKE_TRANSFER_SCAN_SAMPLES_PER_ORBIT TO 32.
SET IKE_BPLANE_DV_CAP TO 100.
SET IKE_REFINE_BPLANE_DV_CAP TO 30.
SET IKE_MISSION_SETTINGS TO LEXICON(
    "MISSION_ID","ike_impactor_ops","MISSION_NAME","Espoir — Ike Impact",
    "MISSION_CACHE_NEXT_BAND",1,"MISSION_CACHE_HANDOFF_PHASES",LIST(),"MISSION_TYPE","moon_operations","PAYLOADS",LIST("PROBE"),
    "CAPTURE_PE",25000,"CAPTURE_MIN_PE",20000,"CAPTURE_MAX_PE",30000,
    "CAPTURE_INC",-1,"CAPTURE_LAN",-1,"CAPTURE_AOP",-1,"CAPTURE_DIR","",
    "TARGET_AP",75000,"CAPTURE_RESERVE_DV",150,
    "BPLANE_PE_ONLY",1,"BPLANE_REQUIRE_PLANE",0,"BPLANE_PE_TOL",5000,
    "BPLANE_TRIM_DV_CAP",100,"BPLANE_TRIM_TOTAL_DV_CAP",150,"BPLANE_TRIM_RESERVE_DV",200,
    "SCIENCE_ENTRY_BANDS",LEXICON("IKE",LIST(50000,0)),
    "SCIENCE_IMPACT_PE",-1000,"SCIENCE_IMPACT_DV_CAP",150,"SCIENCE_ENTRY_MIN_EC",0.05).
