// Capture first; choose the landing site after surveying. One-way science.
SET MISSION_ID TO "moho_lander".
SET MISSION_NAME TO "Espoir — Moho Science Lander".
SET MISSION_TYPE TO "interplanetary".
SET MISSION_CACHE_NEXT_BAND TO 1.
SET TARGET_ TO "MOHO".
SET PAYLOADS TO LIST("PROBE").
SET SEQUENCE TO LIST("PRELAUNCH","LAUNCH","FAIR","ANTS","PARK","XING","BPLANE",
    "COAST_1HALF","REFINE_BPLANE","COAST_2HALF","CAPTURE","LANDING_REVIEW",
    "LAND_DEORBIT","LAND_ASSIST","SURFACE_SCIENCE","DONE").
SET PARKING_ALT TO 85000.
SET LAUNCH_INCLINATION TO 0.
SET LAUNCH_PLANE_MODE TO "INTERPLANETARY".
SET TRANSFER_SCAN_SAMPLES_PER_ORBIT TO 16.
SET CAPTURE_PE TO 25000.
SET CAPTURE_MIN_PE TO 23000.
SET CAPTURE_MAX_PE TO 27000.
SET CAPTURE_INC TO 90.
SET CAPTURE_LAN TO -1.
SET CAPTURE_AOP TO -1.
SET CAPTURE_DIR TO "POLAR".
SET TARGET_AP TO 25000.
SET BPLANE_PE_ONLY TO 0.
SET BPLANE_REQUIRE_PLANE TO 1.
SET BPLANE_PE_TOL TO 2000.
SET BPLANE_ANG_TOL TO 0.5.
SET BPLANE_DV_CAP TO 150.
SET REFINE_BPLANE_DV_CAP TO 50.
SET BPLANE_TRIM_DV_CAP TO 150.
SET BPLANE_TRIM_TOTAL_DV_CAP TO 250.
// Moho's surface gravity/circular speed require more descent fuel than Ike.
SET BPLANE_TRIM_RESERVE_DV TO 1200.
SET BPLANE_CAPTURE_MARGIN TO 1200.
SET CAPTURE_RESERVE_DV TO 1200.
SET TARGET_LAT TO 0.
SET TARGET_LNG TO 0.
SET TARGET_LOCK TO 0.
SET TARGET_WAYPOINT TO "".
SET LANDING_USE_WAYPOINTS TO 1.
SET LANDING_FLEXIBLE_SITE TO 0.
SET LANDING_TARGET_REVIEW_REQUIRED TO 1.
SET LANDING_AUTO_TARGET TO 0.
SET LANDING_CONFIRM_TARGET TO 0.
SET LANDING_LIGHT_MODE TO "SUNLIT".
SET LANDING_SUN_MIN_ELEV TO 5.
SET LANDING_SUN_MAX_ELEV TO 85.
SET LANDING_RADIO_MODE TO "DIRECT".
SET LANDING_REQUIRE_KERBIN TO 1.
SET LANDING_KERBIN_MIN_ELEV TO 15.
SET LANDING_KERBIN_PREFERRED_ELEV TO 30.
SET LANDING_ECONOMY_BRAKE TO 1.
SET LANDING_POWERED_LEAD TO 1.
SET LANDING_STAGE_BRAKE_CREDIT TO 1.
SET LANDING_ECONOMY_TERMINAL_RETARGET TO 0.
SET LANDING_APPROACH_MAX_TIME TO 120.
SET LANDING_STAGE_DISCARD_HSPEED TO 0.
SET LANDING_RETURN_DECOUPLER_TAG TO "".
SET LANDING_RELEASE_DECOUPLER_TAG TO "".
SET LANDING_TERRAIN_MAX_SLOPE TO 5.
SET LANDING_SITE_MAX_SLOPE TO 5.
SET LANDING_DIVERT_EMERGENCY_SLOPE TO 15.
SET TERRAIN_VALIDATE TO TRUE.
SET TARGET_TOLERANCE TO 1500.
SET TARGET_DEORBIT_NORMAL_DV_CAP TO 10.
SET RELOAD_AFTER_LAND_ASSIST TO 0.
SET RELOAD_AFTER_LAND TO 0.
SET SCIENCE_SURFACE_DWELL TO 600.
SET SCIENCE_SURFACE_MIN_EC TO 0.05.
SET SOLAR_REORIENT_PERIOD TO 21600.
SET COAST_AUTO_WARP TO 0.
