// Contract orbit first; command-selected polar mapping after operator review.
SET MISSION_ID TO "minmus_orbital_surveyor".
SET MISSION_NAME TO "Espoir — Minmus Contract and Polar Surveyor".
SET MISSION_TYPE TO "kerbin_moon".
SET MISSION_EXCURSIONS TO 1.
SET MISSION_CACHE_NEXT_BAND TO 1.
SET TARGET_ TO "MINMUS".
SET PAYLOADS TO LIST("SCANSAT").
SET SEQUENCE TO LIST("PRELAUNCH","LAUNCH","FAIR","ANTS","PARK","XING","BPLANE",
    "COAST_1HALF","REFINE_BPLANE","COAST_2HALF","CAPTURE","SHAPE","SCIENCE_OPS","DONE").
SET PARKING_ALT TO 85000.
SET LAUNCH_INCLINATION TO 0.
SET LAUNCH_PLANE_MODE TO "BODY_ORBIT".
SET TRANSFER_SCAN_SAMPLES_PER_ORBIT TO 16.
SET CAPTURE_PE TO 465764.
SET CAPTURE_MIN_PE TO 460764.
SET CAPTURE_MAX_PE TO 470764.
SET CAPTURE_INC TO 21.6.
SET CAPTURE_LAN TO -1.
SET CAPTURE_AOP TO -1.
SET CAPTURE_DIR TO "PROGRADE".
SET TARGET_AP TO 1041045.
SET TARGET_PE TO 465764.
SET BPLANE_PE_ONLY TO 0.
SET BPLANE_REQUIRE_PLANE TO 1.
SET BPLANE_PE_TOL TO 3000.
SET BPLANE_MINIMUM_PE_TOL TO 5000.
SET BPLANE_ANG_TOL TO 1.
SET BPLANE_DV_CAP TO 100.
SET REFINE_BPLANE_DV_CAP TO 100.
SET BPLANE_TRIM_DV_CAP TO 100.
SET BPLANE_TRIM_TOTAL_DV_CAP TO 200.
SET BPLANE_TRIM_RESERVE_DV TO 300.
SET BPLANE_CAPTURE_MARGIN TO 300.
SET CAPTURE_RESERVE_DV TO 300.
SET SHAPE_AP TO 1041045.
SET SHAPE_PE TO 465764.
SET SHAPE_INC TO 21.6.
SET SHAPE_LAN TO 255.5.
SET SHAPE_AOP TO 157.3.
SET SHAPE_ALT_TOL TO 500.
SET SHAPE_ANG_TOL TO 0.1.
SET SHAPE_AOP_TOL TO 0.2.
SET SHAPE_MIN_BURN_DV TO 0.002.
SET SHAPE_BURN_TOLERANCE TO 0.001.
SET SHAPE_MIN_PE TO 10000.
SET SHAPE_DV_CAP TO 500.
SET SHAPE_TOTAL_DV_CAP TO 1500.
SET SHAPE_RESERVE_DV TO 300.
SET EXCURSION_RESERVE_DV TO 300.
SET SCIENCE_OPS_HOLD TO 1.
SET SCIENCE_OPS_RUN_ALL TO 0.
SET SCANSAT_DECOUPLER_TAG TO "".
SET SCANSAT_DISPOSE_CARRIER TO 0.
SET SCANSAT_DISPOSE_BEFORE_RELEASE TO 0.
SET SCANSAT_STAGE_AFTER_RELEASE TO 0.
SET SCANSAT_AUTO_DEORBIT TO 0.
SET SCANSAT_POWER_GUARD TO 1.
SET SCANSAT_POWER_LOW TO 0.3.
SET SCANSAT_POWER_RESUME TO 0.6.
SET SCANSAT_REQUIRED_TYPES TO LIST("LOW_RES_ALTIMETRY","LOW_RES_RESOURCES","BIOME").
SET SOLAR_REORIENT_PERIOD TO 21600.
SET COAST_AUTO_WARP TO 0.
