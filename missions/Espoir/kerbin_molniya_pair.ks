// Stock Kerbin T10774s (2h59m34s), e0.65, critical inclination63.4deg.
// a=(mu*(T/(2*pi))^2)^(1/3); rounded apsides remain inside contract bounds.
SET MISSION_ID TO "kerbin_molniya_pair".
SET MISSION_NAME TO "Espoir — Kerbin Northern Payload and Southern Carrier Relay".
SET MISSION_TYPE TO "kerbin_orbit".
SET MISSION_CACHE_NEXT_BAND TO 1.
SET TARGET_ TO "KERBIN".
SET PAYLOADS TO LIST("RELAY").
SET SEQUENCE TO LIST("PRELAUNCH","LAUNCH","FAIR","ANTS","PARK","SHAPE","MOLNIYA_PAIR","DONE").
SET PARKING_ALT TO 85000.
SET LAUNCH_PLANE_MODE TO "".
SET LAUNCH_INCLINATION TO 63.4.
SET TARGET_INCLINATION TO 63.4.
SET CAPTURE_INC TO -1.
SET CAPTURE_LAN TO -1.
SET TARGET_AP TO 2999751.
SET TARGET_PE TO 163584.
SET SHAPE_AP TO 2999751.
SET SHAPE_PE TO 163584.
SET SHAPE_INC TO 63.4.
SET SHAPE_LAN TO -1.
SET SHAPE_AOP TO 270.
SET SHAPE_MIN_PE TO 80000.
SET SHAPE_ALT_TOL TO 1000.
SET SHAPE_ANG_TOL TO 0.1.
SET SHAPE_AOP_TOL TO 0.5.
SET SHAPE_MIN_BURN_DV TO 0.1.
SET SHAPE_BURN_TOLERANCE TO 0.01.
SET SHAPE_DV_CAP TO 1500.
SET SHAPE_TOTAL_DV_CAP TO 2500.
SET SHAPE_RESERVE_DV TO 1000.
SET SCIENCE_OPS_HOLD TO 1.
SET SCIENCE_OPS_RUN_ALL TO 0.
SET COAST_AUTO_WARP TO 0.

// Northern payload on relay_1; the powered carrier becomes southern relay.
// Disable normal staging on this separator; both units need their own power
// and HG-20 or stronger relay. Only the carrier needs propulsion/kOS.
SET MOLNIYA_PAIR_AP TO 2999751.
SET MOLNIYA_PAIR_PE TO 163584.
SET RELAY_VERIFY_HARDWARE TO 1.
SET RELAY_MIN_PANELS TO 6.
SET RELAY_MIN_EC TO 200.
SET RELAY_NAME_PREFIX TO "Espoir-Kerbin-Molniya".
// Orbital maneuvers must fit the active carrier engine; never stage payloads.
SET BURN_STAGE_MAX_EVENTS TO 0.
SET BURN_STAGE_MANUAL_WAIT TO 0.
