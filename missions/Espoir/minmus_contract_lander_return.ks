// Contract orbit, polar parking, two operator-selected sites, then Kerbin return.
// Stop at each review; use visit once for the second site, then select return.
SET MISSION_ID TO "minmus_contract_lander_return".
SET MISSION_NAME TO "Espoir — Minmus Contract, Two Sites and Return".
SET MISSION_TYPE TO "kerbin_moon".
SET MISSION_EXCURSIONS TO 1.
SET MISSION_CACHE_NEXT_BAND TO 1.
SET TARGET_ TO "MINMUS".
SET PAYLOADS TO LIST("PROBE").
SET SEQUENCE TO LIST("PRELAUNCH","LAUNCH","FAIR","ANTS","PARK","XING","BPLANE",
    "COAST_1HALF","REFINE_BPLANE","COAST_2HALF","CAPTURE","SHAPE","SCIENCE_OPS","LAND_PREP","LANDING_REVIEW",
    "LAND_DEORBIT","LAND_ASSIST","SURFACE_SCIENCE","SURFACE_REVIEW","SURFACE_RETURN_SETUP").
SET PARKING_ALT TO 85000.
SET LAUNCH_INCLINATION TO 0.
SET LAUNCH_PLANE_MODE TO "BODY_ORBIT".
SET TRANSFER_SCAN_SAMPLES_PER_ORBIT TO 16.
SET CAPTURE_PE TO 15000.
SET CAPTURE_MIN_PE TO 13000.
SET CAPTURE_MAX_PE TO 17000.
SET CAPTURE_INC TO 21.6.
SET CAPTURE_LAN TO -1.
SET CAPTURE_AOP TO -1.
SET CAPTURE_DIR TO "PROGRADE".
// Capture deep in Minmus gravity, raise Pe only after capture.
SET TARGET_AP TO 1041045.
SET TARGET_PE TO 15000.
SET BPLANE_PE_ONLY TO 0.
SET BPLANE_REQUIRE_PLANE TO 1.
SET BPLANE_PE_TOL TO 2000.
SET BPLANE_ANG_TOL TO 0.5.
SET BPLANE_DV_CAP TO 100.
SET REFINE_BPLANE_DV_CAP TO 100.
SET BPLANE_TRIM_DV_CAP TO 100.
SET BPLANE_TRIM_TOTAL_DV_CAP TO 200.
SET BPLANE_TRIM_RESERVE_DV TO 900.
SET BPLANE_CAPTURE_MARGIN TO 900.
SET CAPTURE_RESERVE_DV TO 900.
SET SHAPE_AP TO 1041045.
SET SHAPE_PE TO 465764.
SET SHAPE_INC TO 21.6.
SET SHAPE_LAN TO 255.5.
SET SHAPE_AOP TO 157.3.
SET SHAPE_MIN_PE TO 10000.
SET SHAPE_ALT_TOL TO 500.
SET SHAPE_ANG_TOL TO 0.1.
SET SHAPE_AOP_TOL TO 0.2.
SET SHAPE_MIN_BURN_DV TO 0.002.
SET SHAPE_BURN_TOLERANCE TO 0.001.
SET SHAPE_DV_CAP TO 500.
SET SHAPE_TOTAL_DV_CAP TO 1500.
SET SHAPE_RESERVE_DV TO 900.
SET EXCURSION_RESERVE_DV TO 500.
// Contract review prints continuation to LAND_PREP. No orbital experiments
// consume one-shot science before the surface campaign.
SET SCIENCE_OPS_HOLD TO 1.
SET SCIENCE_OPS_RUN_ALL TO 0.
// Change plane while high, then lower apsides using the shared native planner.
// Current-stage admission remains in force: no speculative future fuel credit.
SET LAND_PREP_AP TO 15000.
SET LAND_PREP_PE TO 15000.
SET LAND_PREP_INC TO 90.
SET LAND_PREP_LAN TO -1.
SET LAND_PREP_MIN_PE TO 10000.
SET LAND_PREP_ALT_TOL TO 500.
SET LAND_PREP_ANG_TOL TO 0.5.
SET LAND_PREP_MIN_BURN_DV TO 0.1.
SET LAND_PREP_DV_CAP TO 150.
SET LAND_PREP_TOTAL_DV_CAP TO 300.
SET LAND_PREP_RESERVE_DV TO 900.
SET TARGET_LAT TO 0.
SET TARGET_LNG TO 0.
SET TARGET_LOCK TO 0.
SET TARGET_WAYPOINT TO "".
SET LANDING_USE_WAYPOINTS TO 1.
SET LANDING_FLEXIBLE_SITE TO 0.
SET LANDING_TARGET_REVIEW_REQUIRED TO 1.
SET LANDING_AUTO_TARGET TO 0.
// Explicit landsite/visit command is the operator's target confirmation.
SET LANDING_CONFIRM_TARGET TO 0.
SET LANDING_LIGHT_MODE TO "SUNLIT".
SET LANDING_SUN_MIN_ELEV TO 5.
SET LANDING_SUN_MAX_ELEV TO 85.
SET LANDING_RADIO_MODE TO "AUTO".
SET LANDING_REQUIRE_KERBIN TO 1.
SET LANDING_KERBIN_MIN_ELEV TO 15.
SET LANDING_KERBIN_PREFERRED_ELEV TO 30.
SET LANDING_ECONOMY_BRAKE TO 1.
SET LANDING_POWERED_LEAD TO 1.
SET LANDING_STAGE_BRAKE_CREDIT TO 1.
SET LANDING_ECONOMY_TERMINAL_RETARGET TO 0.
SET LANDING_APPROACH_MAX_TIME TO 120.
SET LANDING_STAGE_DISCARD_HSPEED TO 0.
SET LANDING_RETURN_DECOUPLER_TAG TO "".
SET LANDING_RELEASE_DECOUPLER_TAG TO "".
SET LANDING_TERRAIN_MAX_SLOPE TO 5.
SET LANDING_SITE_MAX_SLOPE TO 5.
SET LANDING_DIVERT_EMERGENCY_SLOPE TO 15.
SET TERRAIN_VALIDATE TO TRUE.
SET TARGET_TOLERANCE TO 1500.
SET TARGET_DEORBIT_NORMAL_DV_CAP TO 10.
SET RELOAD_AFTER_LAND_ASSIST TO 0.
SET RELOAD_AFTER_LAND TO 0.
SET SCIENCE_SURFACE_DWELL TO 600.
SET SCIENCE_SURFACE_MIN_EC TO 0.05.
SET COAST_AUTO_WARP TO 0.

// Surface review selects this leg explicitly after the second site (or early
// if fuel is insufficient). Stock chutes required on the retained return core.
SET SURFACE_RETURN_PARKING_ALT TO 15000.
SET SURFACE_RETURN_INCLINATION TO 0.
SET RETURN_SEQUENCE TO LIST("ESCAPE","COAST","MCC","AEROBRAKE","DESCENT","DONE").
SET RETURN_PE TO 52000.
SET RETURN_PE_TOLERANCE TO 1000.
SET RETURN_PE_MIN TO 52000.
SET RETURN_REENTRY_DIR TO "RETROGRADE".
SET RETURN_KSC_TARGET TO 0.
SET RETURN_ARM_CHUTES TO 1.
// No automatic separation based on RO9-specific tags.
SET RETURN_DESCENT_FAIRING_TAG TO "none".
SET RETURN_DESCENT_DECOUPLER_TAG TO "none".
SET RETURN_DESCENT_CHUTES_TAG TO "".
SET AEROBRAKE_AP_BURN TO 1.
SET AEROBRAKE_AP_RESERVE_DV TO 10.
