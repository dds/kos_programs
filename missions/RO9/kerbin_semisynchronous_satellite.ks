// Stock Kerbin: a=(mu*(T/(2*pi))^2)^(1/3), altitude=a-600000m.
// T=10774s (2h59m34s), midway inside2h52m23s..3h06m45s.
// Circular target keeps eccentricity well below0.02; inclination centered55deg.
SET MISSION_ID TO "kerbin_semisynchronous_satellite".
SET MISSION_NAME TO "RO9 Kerbin Medium Semisynchronous Science Satellite".
SET TARGET_ TO "KERBIN".
SET PAYLOADS TO LIST("SCISAT").
SET SEQUENCE TO LIST("PRELAUNCH","LAUNCH","FAIR","ANTS","PARK","SHAPE","SCIENCE_OPS","DONE").
// SHAPE's Kerbin floor is atmosphere+10km (80km); allow ascent residual.
SET PARKING_ALT TO 85000.
SET LAUNCH_PLANE_MODE TO "".
SET LAUNCH_INCLINATION TO 55.
SET TARGET_INCLINATION TO 55.
SET CAPTURE_INC TO -1.
SET CAPTURE_LAN TO -1.
SET TARGET_AP TO 1581668.
SET TARGET_PE TO 1581668.
SET SHAPE_AP TO 1581668.
SET SHAPE_PE TO 1581668.
SET SHAPE_INC TO 55.
SET SHAPE_LAN TO -1.
SET SHAPE_AOP TO -1.
SET SHAPE_ALT_TOL TO 2500.
SET SHAPE_ANG_TOL TO 0.2.
SET SHAPE_MIN_BURN_DV TO 0.1.
SET SHAPE_DV_CAP TO 1300.
SET SHAPE_TOTAL_DV_CAP TO 1900.
SET SHAPE_RESERVE_DV TO 100.
SET AUTO_TRANSMIT TO 1.
SET SCIENCE_OPS_HOLD TO 1.
SET SCIENCE_SURVEY_POINTS TO LIST().
