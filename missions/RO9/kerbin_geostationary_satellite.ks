// Park a science satellite at the specified geostationary altitude.
// No longitude slot was requested; leave LAN/AoP unconstrained.
SET MISSION_ID TO "kerbin_geostationary_satellite".
SET MISSION_NAME TO "RO9 Kerbin Geostationary Science Satellite".
SET TARGET_ TO "KERBIN".
SET PAYLOADS TO LIST("SCISAT").
SET SEQUENCE TO LIST("PRELAUNCH","LAUNCH","FAIR","ANTS","PARK","SHAPE","SCIENCE_OPS","DONE").
SET PARKING_ALT TO 78000.
SET LAUNCH_PLANE_MODE TO "".
SET LAUNCH_INCLINATION TO 0.
SET TARGET_INCLINATION TO 0.
SET CAPTURE_INC TO -1.
SET CAPTURE_LAN TO -1.
SET TARGET_AP TO 2863334.
SET TARGET_PE TO 2863334.
SET SHAPE_AP TO 2863334.
SET SHAPE_PE TO 2863334.
SET SHAPE_INC TO 0.
SET SHAPE_LAN TO -1.
SET SHAPE_AOP TO -1.
SET SHAPE_ALT_TOL TO 1000.
SET SHAPE_ANG_TOL TO 0.1.
// At this radius0.1m/s can move an apsis by more than1km.
SET SHAPE_MIN_BURN_DV TO 0.02.
SET SHAPE_BURN_TOLERANCE TO 0.005.
SET SHAPE_DV_CAP TO 1600.
SET SHAPE_TOTAL_DV_CAP TO 2200.
SET SHAPE_RESERVE_DV TO 100.
SET AUTO_TRANSMIT TO 1.
SET SCIENCE_OPS_HOLD TO 1.
SET SCIENCE_SURVEY_POINTS TO LIST().
