// Contract-style retrograde polar orbit, centered inside96-102deg/500-900km.
// Targets these orbital elements; does not add Sun-tracking station keeping.
SET MISSION_ID TO "kerbin_sunsync_satellite".
SET MISSION_NAME TO "RO9 Kerbin Retrograde Polar Science Satellite".
SET TARGET_ TO "KERBIN".
SET PAYLOADS TO LIST("SCISAT").
SET SEQUENCE TO LIST("PRELAUNCH","LAUNCH","FAIR","ANTS","PARK","SHAPE","SCIENCE_OPS","DONE").
SET PARKING_ALT TO 78000.
SET LAUNCH_PLANE_MODE TO "".
SET LAUNCH_INCLINATION TO 99.
SET TARGET_INCLINATION TO 99.
SET CAPTURE_INC TO -1.
SET CAPTURE_LAN TO -1.
SET TARGET_AP TO 700000.
SET TARGET_PE TO 700000.
SET SHAPE_AP TO 700000.
SET SHAPE_PE TO 700000.
SET SHAPE_INC TO 99.
SET SHAPE_LAN TO -1.
SET SHAPE_AOP TO -1.
SET SHAPE_ALT_TOL TO 2500.
SET SHAPE_ANG_TOL TO 0.2.
SET SHAPE_MIN_BURN_DV TO 0.1.
SET SHAPE_DV_CAP TO 900.
SET SHAPE_TOTAL_DV_CAP TO 1400.
SET SHAPE_RESERVE_DV TO 100.
SET AUTO_TRANSMIT TO 1.
SET SCIENCE_OPS_HOLD TO 1.
SET SCIENCE_SURVEY_POINTS TO LIST().
