// RO9: polar contract orbit -> A landing -> B/C/D hops with science stops
// -> high equatorial contract orbit -> assisted Kerbin return. Metres ASL.
SET MISSION_ID TO "minmus_polar_hops_return".
SET MISSION_NAME TO "RO9 Minmus Polar Orbit, Four Sites and Return".
SET TARGET_ TO "MINMUS".
SET PAYLOADS TO LIST("SCISAT").
SET PARKING_ALT TO 78000.
SET SEQUENCE TO LIST(
    "PRELAUNCH","LAUNCH","FAIR","ANTS","PARK",
    "XING","BPLANE","COAST_1HALF","REFINE_BPLANE","COAST_2HALF",
    "CAPTURE","SHAPE","LAND_PREP","LAND_DEORBIT","LAND_ASSIST",
    "HOP_ROUTE_SETUP","SURFACE_RETURN_SETUP").
SET LAUNCH_INCLINATION TO 0.
SET LAUNCH_PLANE_MODE TO "BODY_ORBIT".
SET TRANSFER_SCAN_SAMPLES_PER_ORBIT TO 16.

// Capture near the requested high Pe; finish LAN/AoP in the bound orbit.
SET CAPTURE_PE TO 444576.
SET CAPTURE_INC TO 90.
SET CAPTURE_LAN TO -1.
SET CAPTURE_AOP TO 244.9.
SET CAPTURE_DIR TO "PROGRADE".
SET TARGET_PE TO 444576.
SET TARGET_AP TO 1064182.
SET BPLANE_PE_ONLY TO 0.
SET BPLANE_REQUIRE_PLANE TO 1.
SET BPLANE_PE_TOL TO 1000.
SET BPLANE_ANG_TOL TO 1.
SET BPLANE_MINIMUM_PE_TOL TO 1500.
SET CAPTURE_MIN_PE TO 443076.
SET CAPTURE_MAX_PE TO 446076.
SET CAPTURE_ACCEPT_BOUND TO 0.
SET BPLANE_DV_CAP TO 100.
SET REFINE_BPLANE_DV_CAP TO 100.
SET BPLANE_TRIM_DV_CAP TO 100.
SET BPLANE_TRIM_TOTAL_DV_CAP TO 200.
SET BPLANE_TRIM_RESERVE_DV TO 1400.
SET BPLANE_CAPTURE_MARGIN TO 1400.
SET CAPTURE_RESERVE_DV TO 1400.
SET BPLANE_MAX_ARRIVAL_SHIFT TO 600.
SET BPLANE_MAX_CAPTURE_DV_INCREASE TO 20.
SET SHAPE_AP TO 1064182.
SET SHAPE_PE TO 444576.
SET SHAPE_INC TO 90.
SET SHAPE_LAN TO 298.9.
SET SHAPE_AOP TO 244.9.
SET SHAPE_ALT_TOL TO 100.
SET SHAPE_ANG_TOL TO 0.1.
SET SHAPE_AOP_TOL TO 0.2.
SET SHAPE_MIN_BURN_DV TO 0.002.
SET SHAPE_BURN_TOLERANCE TO 0.001.
SET SHAPE_MIN_PE TO 10000.
SET SHAPE_DV_CAP TO 300.
SET SHAPE_TOTAL_DV_CAP TO 500.
SET SHAPE_RESERVE_DV TO 1300.

// After completing the first objective, lower both apsides to a practical
// landing orbit. Keep the polar plane; wait for a reachable target pass.
SET LAND_PREP_AP TO 19300.
SET LAND_PREP_PE TO 9300.
SET LAND_PREP_MIN_PE TO 9000.
SET LAND_PREP_ALT_TOL TO 250.
SET LAND_PREP_RESERVE_DV TO 1200.
SET TARGET_LAT TO -1.080.
SET TARGET_LNG TO 1.365.
SET TARGET_LOCK TO 1.
SET TARGET_WAYPOINT TO "".
SET LANDING_USE_WAYPOINTS TO 0.
SET LANDING_AUTO_TARGET TO 0.
SET LANDING_FLEXIBLE_SITE TO 0.
SET LANDING_CONFIRM_TARGET TO 0.
SET LANDING_LIGHT_MODE TO "ANY".
// Shared body/relay radio policy still applies before deorbit.
SET LANDING_REQUIRE_KERBIN TO 0.
SET LANDING_SITE_SCAN_ENABLE TO 0.
SET LANDING_REQUIRE_SITE TO 0.
SET LANDING_SKIP_TARGET_SEARCH TO 0.
SET LANDING_ECONOMY_BRAKE TO 1.
SET LANDING_STAGE_BRAKE_CREDIT TO 1.
SET LANDING_POWERED_LEAD TO 1.
SET LANDING_STAGE_DISCARD_HSPEED TO 0.
SET TARGET_DEORBIT_PASS_LOOKAHEAD_ROTATIONS TO 1.
SET TARGET_DEORBIT_NORMAL_DV_CAP TO 10.
SET TARGET_DEORBIT_PREFERRED_CROSSTRACK_KM TO 0.25.
SET DEORBIT_CROSSTRACK_AUTHORITY_KM TO 0.5.
SET TARGET_TOLERANCE TO 1500.
SET GUIDANCE_ALT TO 3000.
SET TARGET_DEORBIT_SCAN_ORBITS TO 48.
SET TARGET_DEORBIT_SCAN_SAMPLES TO 512.
SET TARGET_DEORBIT_MIN_LEAD TO 120.
// A/B are only270m apart. Do not shift sites by the usual500m terrain grid.
// Retain terrain/slope checks; unsafe or missed sites hold on the surface.
SET TERRAIN_CHECK_RADIUS TO 20.
SET TERRAIN_CHECK_STEP TO 10.
SET VERTICAL_RADIUS TO 20.
SET MAX_TILT TO 12.
SET RELOAD_AFTER_LAND_ASSIST TO 0.
SET RELOAD_AFTER_LAND TO 0.

// A is the initial touchdown; only B, C and D require hop launches.
// Ten minutes of game time at1x at each site, with an alarm before science.
SET HOP_ROUTE_SITES TO LIST(
    LIST(-1.080,1.365),LIST(-1.190,1.596),
    LIST(-1.554,2.780),LIST(-3.029,2.189)).
SET HOP_SITE_DWELL_SECONDS TO 600.
SET HOP_SITE_RADIUS TO 100.
SET HOP_SITE_RUN_SCIENCE TO 1.
SET HOP_TOLERANCE TO 50.
SET HOP_PITCH TO 45.
SET HOP_MAX_BURN_SECONDS TO 90.
SET HOP_MAX_AP_KM TO 5.
SET HOP_TWR TO 2.5.
SET HOP_RETURN_RESERVE_DV TO 700.
SET HOP_LANDING_RESERVE_DV TO 180.
// Run available experiments; retain their data for return. No automatic
// reset or transmission, and unavailable/used experiments are skipped.
SET AUTO_TRANSMIT TO 0.

// Launch east, then SHAPE removes the small unavoidable latitude plane
// error and establishes the requested ellipse before departing for Kerbin.
SET SURFACE_RETURN_PARKING_ALT TO 10000.
SET SURFACE_RETURN_INCLINATION TO 0.
SET SURFACE_RETURN_SEQUENCE TO LIST("PRELAUNCH","LAUNCH","PARK","SHAPE","RETURN_SETUP").
SET SURFACE_RETURN_ORBIT TO LEXICON(
    "AP",659734,"PE",554472,"INC",0,"LAN",-1,"AOP",0.4,
    "ALT_TOL",100,"ANG_TOL",0.1,"AOP_TOL",0.2,
    "MIN_BURN_DV",0.002,"BURN_TOLERANCE",0.001,"MIN_PE",10000,
    "DV_CAP",150,"TOTAL_DV_CAP",250,"RESERVE_DV",300).
SET RETURN_SEQUENCE TO LIST("ESCAPE","COAST","MCC","AEROBRAKE","DESCENT","DONE").
SET RETURN_PE TO 53000.
SET RETURN_PE_TOLERANCE TO 1000.
SET RETURN_REENTRY_DIR TO "RETROGRADE".
SET RETURN_KSC_TARGET TO 0.
SET RETURN_ARM_CHUTES TO 1.
SET AEROBRAKE_AP_BURN TO 1.
SET AEROBRAKE_AP_RESERVE_DV TO 10.
SET RETURN_DESCENT_FAIRING_TAG TO "none".
SET RETURN_DESCENT_DECOUPLER_TAG TO "return_decoupler".
SET RETURN_DESCENT_DECOUPLE_ALT TO 6000.
SET RETURN_DESCENT_CHUTES_TAG TO "descent_chutes".
SET RETURN_DESCENT_RELEASE_ALT TO 10000.
