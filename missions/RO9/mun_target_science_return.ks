// Fixed Mun science landing at-10.590,99.490, then Kerbin return.
// No polar survey, hops, or optional KSC targeting.
SET MISSION_ID TO "mun_target_science_return".
SET MISSION_NAME TO "RO9 Mun Target Science Landing and Return".
SET TARGET_ TO "MUN".
SET PAYLOADS TO LIST("SCISAT").
SET PARKING_ALT TO 78000.
SET SEQUENCE TO LIST("PRELAUNCH","LAUNCH","FAIR","ANTS","PARK",
    "XING","BPLANE","COAST_1HALF","REFINE_BPLANE","COAST_2HALF",
    "CAPTURE","LAND_DEORBIT","LAND_ASSIST","SCIENCE_OPS","SURFACE_RETURN_SETUP").
SET LAUNCH_INCLINATION TO 0.
SET LAUNCH_PLANE_MODE TO "BODY_ORBIT".
SET TRANSFER_SCAN_SAMPLES_PER_ORBIT TO 16.
// A15deg orbit reaches the site's10.59deg latitude without a90deg polar
// arrival or an impossible late deorbit latitude correction.
SET CAPTURE_PE TO 15000.
SET CAPTURE_INC TO 15.
SET CAPTURE_LAN TO -1.
SET CAPTURE_AOP TO -1.
SET CAPTURE_DIR TO "PROGRADE".
SET TARGET_PE TO 15000.
SET TARGET_AP TO 15000.
SET CAPTURE_MIN_PE TO 13000.
SET CAPTURE_MAX_PE TO 17000.
SET CAPTURE_ACCEPT_BOUND TO 0.
SET BPLANE_PE_ONLY TO 0.
SET BPLANE_REQUIRE_PLANE TO 1.
SET BPLANE_PE_TOL TO 2000.
SET BPLANE_ANG_TOL TO 1.
SET BPLANE_DV_CAP TO 60.
SET REFINE_BPLANE_DV_CAP TO 60.
SET BPLANE_TRIM_DV_CAP TO 60.
SET BPLANE_TRIM_TOTAL_DV_CAP TO 100.
SET BPLANE_TRIM_RESERVE_DV TO 1500.
SET BPLANE_CAPTURE_MARGIN TO 1500.
SET CAPTURE_RESERVE_DV TO 1500.
SET BPLANE_MAX_ARRIVAL_SHIFT TO -1.
SET BPLANE_MAX_CAPTURE_DV_INCREASE TO -1.
SET TARGET_LAT TO -10.590.
SET TARGET_LNG TO 99.490.
SET TARGET_LOCK TO 1.
SET TARGET_WAYPOINT TO "".
SET LANDING_USE_WAYPOINTS TO 0.
SET LANDING_AUTO_TARGET TO 0.
SET LANDING_FLEXIBLE_SITE TO 0.
SET LANDING_CONFIRM_TARGET TO 0.
// A fixed contract site can be dark or beyond direct Kerbin view. Fly
// autonomously there rather than substitute a different point. This is
// a mission-local waiver, not a claim that a relay network exists.
SET LANDING_LIGHT_MODE TO "ANY".
SET LANDING_RADIO_MODE TO "OFFLINE".
SET LANDING_REQUIRE_KERBIN TO 0.
SET LANDING_DIVERT_REQUIRE_KERBIN TO 0.
SET LANDING_STAGE_BRAKE_CREDIT TO 1.
SET LANDING_ECONOMY_BRAKE TO 1.
SET LANDING_POWERED_LEAD TO 1.
SET TARGET_TOLERANCE TO 500.
SET GUIDANCE_ALT TO 3000.
SET TARGET_DEORBIT_SCAN_ORBITS TO 48.
SET TARGET_DEORBIT_SCAN_SAMPLES TO 512.
SET TARGET_DEORBIT_MIN_LEAD TO 120.
SET TARGET_DEORBIT_PASS_LOOKAHEAD_ROTATIONS TO 1.
SET TARGET_DEORBIT_NORMAL_DV_CAP TO 10.
SET TARGET_DEORBIT_PREFERRED_CROSSTRACK_KM TO 0.25.
SET DEORBIT_CROSSTRACK_AUTHORITY_KM TO 0.5.
// Preserve terrain/slope checks, but restrict refinement to the immediate
// site rather than shifting hundreds of metres away from the coordinates.
SET LANDING_SITE_SCAN_ENABLE TO 0.
SET LANDING_SITE_MAX_SLOPE TO 5.
SET TERRAIN_CHECK_RADIUS TO 20.
SET TERRAIN_CHECK_STEP TO 20.
SET MAX_TILT TO 12.
SET RELOAD_AFTER_LAND_ASSIST TO 0.
SET RELOAD_AFTER_LAND TO 0.
SET AUTO_TRANSMIT TO 0.
SET SCIENCE_OPS_HOLD TO 0.
SET SCIENCE_OPS_RUN_ALL TO 1.
SET SCIENCE_SURVEY_POINTS TO LIST().
SET SURFACE_RETURN_PARKING_ALT TO 10000.
SET SURFACE_RETURN_INCLINATION TO 0.
SET RETURN_SEQUENCE TO LIST("ESCAPE","COAST","MCC","AEROBRAKE","DESCENT","DONE").
SET RETURN_PE TO 53000.
SET RETURN_PE_TOLERANCE TO 1000.
SET RETURN_REENTRY_DIR TO "RETROGRADE".
SET RETURN_KSC_TARGET TO 0.
SET RETURN_ARM_CHUTES TO 1.
SET RETURN_DESCENT_FAIRING_TAG TO "none".
SET RETURN_DESCENT_DECOUPLER_TAG TO "descent_decoupler".
SET RETURN_DESCENT_DECOUPLE_ALT TO 6000.
SET RETURN_DESCENT_CHUTES_TAG TO "descent_chutes".
SET RETURN_DESCENT_RELEASE_ALT TO 10000.
