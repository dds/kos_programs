SET CAPTURE_PE TO 15000.
SET CAPTURE_INC TO 0.
SET CAPTURE_DIR TO "PROGRADE".
SET TARGET_PE TO 500000.
SET TARGET_AP TO 500000.
SET SHAPE_PE TO 500000.
SET SHAPE_AP TO 500000.
SET SHAPE_INC TO 0.
SET RELAY_COUNT TO 3.
SET RELAY_ALT TO 500000.
SET KEEP_WARP TO 1.
