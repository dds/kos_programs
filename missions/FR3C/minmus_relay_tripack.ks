// KerboScript mission profile.
SET MISSION_ID TO "minmus_relay_tripack".
SET MISSION_NAME TO "Minmus Relay Tri-Pack".
SET TARGET_ TO "MINMUS".
SET PAYLOADS TO "RELAY".
SET SEQUENCE TO "PRELAUNCH,LAUNCH,FAIR,ANTS,PARK,XING,BPLANE,COAST_1HALF,REFINE_BPLANE,COAST_2HALF,CAPTURE,SHAPE,RELAY_CONSTELLATION,DONE".
SET PARKING_ALT TO 85000.
