// KerboScript mission profile.
SET MISSION_ID TO "jool_scansat_capture".
SET MISSION_NAME TO "Jool SCANsat Capture".
SET TARGET_ TO "JOOL".
SET PAYLOADS TO "SCANSAT".
SET SEQUENCE TO "LAUNCH,FAIR,ANTS,PARK,XING,BPLANE,COAST_1HALF,REFINE_BPLANE,COAST_2HALF,CAPTURE,SHAPE,SCANSAT_OPS,DONE".
SET PARKING_ALT TO 85000.
SET LAUNCH_INCLINATION TO 0.
SET CAPTURE_PE TO 250000.
SET CAPTURE_INC TO 90.
SET CAPTURE_DIR TO "POLAR".
SET TARGET_PE TO 250000.
SET TARGET_AP TO 15000000.
SET SHAPE_PE TO 250000.
SET SHAPE_AP TO 15000000.
SET SHAPE_INC TO 90.
SET SCANSAT_DECOUPLER_TAG TO "scansat_decoupler".
SET SCANSAT_DISPOSE_CARRIER TO 0.
SET SCANSAT_AUTO_DEORBIT TO 0.
SET SCANSAT_POWER_GUARD TO 1.
SET SCANSAT_POWER_LOW TO 0.3.
SET SCANSAT_POWER_RESUME TO 0.6.
SET SOLAR_REORIENT_PERIOD TO 43200.
