// KerboScript mission profile.
SET MISSION_ID TO "kerbin_scansat_249".
SET MISSION_NAME TO "Kerbin SCANsat 249 km Mapper".
SET TARGET_ TO "KERBIN".
SET PAYLOADS TO "SCANSAT".
SET SEQUENCE TO "LAUNCH,FAIR,ANTS,PARK,RAISE,CIRC,INCLINE,SCANSAT_OPS,DONE".
SET PARKING_ALT TO 85000.
SET LAUNCH_INCLINATION TO 90.
SET TARGET_PE TO 249000.
SET TARGET_AP TO 249000.
SET TARGET_INCLINATION TO 90.
SET SCANSAT_DECOUPLER_TAG TO "scansat_decoupler".
SET SCANSAT_DISPOSE_CARRIER TO 0.
SET SCANSAT_AUTO_DEORBIT TO 1.
SET SCANSAT_TARGET_COVERAGE TO 99.1.
SET SCANSAT_REQUIRED_TYPES TO "LOW_RES_ALTIMETRY,LOW_RES_RESOURCES,BIOME".
SET SCANSAT_DEORBIT_PE TO 30000.
SET SCANSAT_DEORBIT_MAX_TIME TO 600.
SET SCANSAT_POWER_LOW TO 0.3.
SET SCANSAT_POWER_RESUME TO 0.6.
SET TARGET_LAT TO -0.1.
SET TARGET_LNG TO -74.25.
SET TARGET_TOLERANCE TO 15000.
SET REENTRY_PE TO 30000.
SET TARGET_DEORBIT_SCAN_ORBITS TO 10.
SET TARGET_DEORBIT_SCAN_SAMPLES TO 320.
SET TARGET_DEORBIT_MIN_LEAD TO 300.
SET DESCENT_RELEASE_ALT TO 38000.
