// KerboScript mission profile.
SET MISSION_ID TO "kerbin_aop_lan_sample".
SET MISSION_NAME TO "Kerbin AoP/LAN Payload Sample".
SET TARGET_ TO "KERBIN".
SET PAYLOADS TO LIST("SCISAT").
