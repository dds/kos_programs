// KerboScript mission profile.
SET MISSION_ID TO "kerbin_scansat_polar".
SET MISSION_NAME TO "Kerbin SCANsat Polar Mapper".
SET TARGET_ TO "KERBIN".
SET PAYLOADS TO "SCANSAT".
SET SEQUENCE TO "LAUNCH,FAIR,ANTS,PARK,RAISE,CIRC,INCLINE,SCANSAT_OPS,DONE".
SET PARKING_ALT TO 85000.
SET LAUNCH_INCLINATION TO 90.
SET TARGET_PE TO 175000.
SET TARGET_AP TO 175000.
SET TARGET_INCLINATION TO 90.
SET SCANSAT_POWER_GUARD TO 1.
SET SCANSAT_POWER_LOW TO 0.3.
SET SCANSAT_POWER_RESUME TO 0.6.
SET SCANSAT_DECOUPLER_TAG TO "scansat_decoupler".
SET SCANSAT_DISPOSE_CARRIER TO 1.
SET SCANSAT_DISPOSE_PE TO 30000.
SET SCANSAT_DISPOSE_MAX_TIME TO 600.
SET SCANSAT_CLEARANCE_DV TO 2.
SET SCANSAT_CLEARANCE_DIR TO "NORMAL".
SET SCANSAT_CLEARANCE_THROTTLE TO 0.25.
SET SCANSAT_CLEARANCE_SETTLE TO 3.
SET DESCENT_RELEASE_ALT TO 29.
