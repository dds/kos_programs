// KerboScript mission profile.
SET MISSION_ID TO "mun_scansat_polar".
SET MISSION_NAME TO "Mun SCANsat Polar Mapper".
SET TARGET_ TO "MUN".
SET PAYLOADS TO LIST("SCANSAT").
SET SEQUENCE TO LIST("LAUNCH", "FAIR", "ANTS", "PARK", "XING", "MCC", "COAST", "CAPTURE", "DROP_FOR_IMPACT_AND_RAISE_PE", "SCANSAT_OPS", "DONE").
SET PARKING_ALT TO 80000.
SET LAUNCH_INCLINATION TO 0.
SET FAIRING_ALT TO 68000.
SET EXTEND_ALT TO 70000.
SET CAPTURE_PE TO 15000.
SET CAPTURE_INC TO 90.
SET CAPTURE_DIR TO "POLAR".
SET TARGET_PE TO 70000.
SET TARGET_AP TO 70000.
SET TARGET_INCLINATION TO 90.
SET MAX_INCL_CHANGE_DV TO 300.
SET SCANSAT_DECOUPLER_TAG TO "scansat_decoupler".
SET SCANSAT_DISPOSE_CARRIER TO 1.
SET SCANSAT_RELEASE_AFTER_CAPTURE TO 1.
SET SCANSAT_DISPOSE_BEFORE_RELEASE TO 1.
SET SCANSAT_DISPOSE_PE TO 2000.
SET SCANSAT_DISPOSE_MAX_TIME TO 600.
SET SCANSAT_STAGE_AFTER_RELEASE TO 1.
SET SCANSAT_RECOVERY_PE TO 70000.
SET SCANSAT_RECOVERY_AP TO 70000.
SET SCANSAT_MAX_NODE_DV TO 1000.
SET SCANSAT_RECOVER_SAFE_PE TO 10000.
SET SCANSAT_CLEARANCE_DV TO 2.
SET SCANSAT_CLEARANCE_DIR TO "NORMAL".
SET SCANSAT_CLEARANCE_THROTTLE TO 0.25.
SET SCANSAT_CLEARANCE_SETTLE TO 3.
