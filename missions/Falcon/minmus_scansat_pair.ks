// KerboScript mission profile.
SET MISSION_ID TO "minmus_scansat_pair".
SET MISSION_NAME TO "Falcon Minmus SCANSat 2".
SET TARGET_ TO "MINMUS".
SET PAYLOADS TO LIST("SCANSAT").
SET SEQUENCE TO LIST("PRELAUNCH", "LAUNCH", "FAIR", "ANTS", "PARK", "XING", "BPLANE", "COAST_1HALF", "REFINE_BPLANE", "COAST_2HALF", "CAPTURE", "SHAPE", "DONE").
SET FAIRING_ALT TO 73750.
SET EXTEND_ALT TO 74000.
SET PARKING_ALT TO 77500.
SET LAUNCH_INCLINATION TO 0.
SET LAUNCH_PLANE_MODE TO "BODY_ORBIT".
SET CAPTURE_PE TO 10000.
SET CAPTURE_INC TO 116.6.
SET CAPTURE_DIR TO "PROGRADE".
SET TARGET_AP TO 500000.
SET TARGET_PE TO 10000.
SET TARGET_INCLINATION TO 116.6.
SET TARGET_LAN TO 278.5.
SET MAX_INCL_CHANGE_DV TO 300.
SET SHAPE_PE TO 9300.
SET SHAPE_AP TO 397272.
SET SHAPE_INC TO 116.6.
SET SHAPE_LAN TO 278.5.
SET SHAPE_AOP TO 90.
SET SHAPE_ALT_TOL TO 5000.
SET PAYLOAD_2_ANTENNA_TAG TO "relay_scan_2_ant".
SET PAYLOAD_2_SOLAR_TAG TO "relay_scan_2_sol".
SET SECONDARY_SEQUENCE TO LIST("SHAPE", "SCANSAT_OPS", "DONE").
SET SECONDARY_RELEASE_TAG TO "relay_scan_1_decoupler".
SET SECONDARY_RELEASE_ANTENNA_TAG TO "relay_scan_1_ant".
SET SECONDARY_RELEASE_SOLAR_TAG TO "relay_scan_1_sol".
SET SCANSAT_DECOUPLER_TAG TO "none".
SET SCANSAT_DISPOSE_CARRIER TO 0.
SET SCANSAT_AUTO_DEORBIT TO 0.
SET SCANSAT_POWER_GUARD TO 1.
SET SCANSAT_TARGET_COVERAGE TO 99.1.
SET SCANSAT_REQUIRED_TYPES TO LIST("MULTISPECTRAL").
SET SCANSAT_POWER_LOW TO 0.3.
SET SCANSAT_POWER_RESUME TO 0.6.
SET SOLAR_REORIENT_PERIOD TO 21600.
SET KEEP_WARP TO 1.
