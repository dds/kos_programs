// KerboScript mission profile.
SET MISSION_ID TO "minmus_polar_science_return".
SET MISSION_NAME TO "Minmus Polar Science Return".
SET TRANSFER_SCAN_SAMPLES_PER_ORBIT TO 16.
SET TARGET_ TO "MINMUS".
SET PAYLOADS TO LIST("SCISAT").
SET SEQUENCE TO LIST("PRELAUNCH", "LAUNCH", "FAIR", "ANTS", "PARK", "XING", "BPLANE", "COAST_1HALF", "REFINE_BPLANE", "COAST_2HALF", "CAPTURE", "SHAPE", "SCIENCE_OPS", "DONE").
SET PARKING_ALT TO 74000.
SET LAUNCH_INCLINATION TO 0.
SET LAUNCH_PLANE_MODE TO "BODY_ORBIT".
SET CAPTURE_PE TO 10000.
SET CAPTURE_INC TO 180.
SET CAPTURE_DIR TO "RETROGRADE".
SET TARGET_PE TO 250000.
SET TARGET_INCLINATION TO 180.
SET MAX_INCL_CHANGE_DV TO 300.
SET EXTEND_ALT TO 72000.
SET FAIRING_ALT TO 71500.
SET SHAPE_PE TO 856737.
SET SHAPE_AP TO 1156174.
SET SHAPE_INC TO 180.
SET SHAPE_AOP TO 23.1.
SET SHAPE_ALT_TOL TO 15000.
SET REENTRY_PE TO 45000.
SET TARGET_LAT TO 0.
SET TARGET_LNG TO -98.39.
SET GUIDANCE_ALT TO 3000.
SET LANDING_SITE_SCAN_ENABLE TO 1.
SET LANDING_SITE_SCAN_RADIUS TO 500.
SET LANDING_SITE_SCAN_STEP TO 100.
SET LANDING_SITE_MAX_SLOPE TO 8.
SET TERRAIN_CHECK_RADIUS TO 500.
SET TERRAIN_CHECK_STEP TO 100.
