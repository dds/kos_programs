// KerboScript mission profile.
SET MISSION_ID TO "falcon_x_lko".
SET MISSION_NAME TO "Falcon-X LKO Shakedown".
SET TARGET_ TO "KERBIN".
SET PAYLOADS TO "CREW".
SET SEQUENCE TO "LAUNCH,ANTS,PARK,KSC_DEORBIT,DESCENT,DONE".
SET PARKING_ALT TO 74000.
SET LAUNCH_INCLINATION TO 28.
SET ORBIT_STAY_TIME TO 600.
SET LIBS_EXTRA TO "descent".
SET TARGET_LAT TO -2.229225388.
SET TARGET_LNG TO -88.06294871.
SET TARGET_TOLERANCE TO 15000.
SET REENTRY_PE TO 30000.
SET TARGET_DEORBIT_SCAN_ORBITS TO 12.
SET TARGET_DEORBIT_SCAN_SAMPLES TO 128.
SET TARGET_DEORBIT_MIN_LEAD TO 300.
SET DESCENT_DECOUPLER_TAG TO "descent_decoupler".
SET DESCENT_DECOUPLE_ALT TO 38000.
SET DESCENT_CHUTES_TAG TO "descent_chutes".
SET DESCENT_RELEASE_ALT TO 37500.
SET DESCENT_HEAT_SHIELD_DROP_ALT TO 30.
SET DESCENT_BAY_REOPEN_ALT TO 42000.
SET DESCENT_SERVICE_ARM_ALT TO 60000.
SET DESCENT_SERVICE_SEPARATION_DROP TO 0.15.
SET DESCENT_SERVICE_RELEASE_ALT TO 500.
