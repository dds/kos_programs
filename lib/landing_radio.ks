// Shared landing communications policy. Update these lists as relays deploy.
@LAZYGLOBAL OFF.
GLOBAL LANDING_DIRECT_KERBIN_BODIES IS LIST("Mun", "Minmus").
GLOBAL LANDING_RELAY_BODIES IS LIST().
// AUTO uses the body lists; DIRECT requires Kerbin; RELAY/OFFLINE waive it.
// AUTO honors legacy LANDING_REQUIRE_KERBIN unless relays are declared.
GLOBAL LANDING_RADIO_MODE IS "AUTO".

GLOBAL FUNCTION landingRequireKerbin {
    IF LANDING_RADIO_MODE = "DIRECT" { RETURN 1. }
    IF LANDING_RADIO_MODE = "RELAY" OR LANDING_RADIO_MODE = "OFFLINE" { RETURN 0. }
    IF LANDING_RADIO_MODE <> "AUTO" { RETURN 1. }
    IF LANDING_RELAY_BODIES:CONTAINS(SHIP:BODY:NAME) { RETURN 0. }
    IF LANDING_REQUIRE_KERBIN > 0 { RETURN 1. }
    IF LANDING_DIRECT_KERBIN_BODIES:CONTAINS(SHIP:BODY:NAME) { RETURN 1. }
    RETURN 0.
}
